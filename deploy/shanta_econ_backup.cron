# SHANTA ECON OS™ — Automated Encrypted Backup Cron Schedule
# Document Ref: GNAI-CRON-BACKUP-2026-0923
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/bin:/usr/sbin
BACKUP_LOG=/var/log/shanta_econ_backup.log

# 1. Run Encrypted Database Dump & Vault Sync Daily at 02:00 UTC
0 2 * * * root cd /app && ./backup-policy.sh > ${BACKUP_LOG} 2>&1

# 2. Run Ameba Server Software Backup Engine Daily at 03:00 UTC
0 3 * * * root cd /app && node serverBackupEngine.mjs --test > ${BACKUP_LOG} 2>&1

# 3. Weekly Off-Site Sync & Prune Backups Older Than 30 Days (Sundays at 04:00 UTC)
0 4 * * 0 root find /app/encrypted_server_vault -type f -name "*.enc.json" -mtime +30 -delete > ${BACKUP_LOG} 2>&1
